{
  "name": "cat-and-dog-gomoku",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:cloudbase": "node node_modules/vite/bin/vite.js build --config cloudbase-probe.config.ts && node node_modules/vite/bin/vite.js build --config game.config.ts && node scripts/build-cloudbase.mjs",
    "dev": "node node_modules/vite/bin/vite.js --config game.config.ts --host 127.0.0.1",
    "test:game-page": "node node_modules/@playwright/test/cli.js test --config playwright.game.config.ts",
    "test:cloudbase-page": "node node_modules/@playwright/test/cli.js test --config playwright.cloudbase.config.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "devDependencies": {
    "@cloudbase/js-sdk": "^3.10.3",
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
